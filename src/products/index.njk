---
layout: layouts/base.njk
title: Products
description: Frameworks, assessments, and toolkits from PraxisIQ — ready-to-deploy resources that give your AI initiatives a head start.
---

<section class="page-header">
  <div class="container">
    <p class="tagline">Products</p>
    <h1 class="page-title">{{ products.headline }}</h1>
    <p class="page-subtitle">{{ products.subheadline }}</p>
    <p style="max-width: 760px; margin-top: 1.5rem; color: var(--n700);">{{ products.intro }}</p>
  </div>
</section>

<section class="section section--subtle" id="differentiators">
  <div class="container">
    <p class="tagline">Why Allocate</p>
    <h2 class="section-heading" style="margin-bottom: 2rem;">What makes the platform different</h2>
    <div class="card-grid">
      {% for differentiator in products.differentiators %}
        <div class="card reveal">
          <span class="card-badge card-badge--{% if loop.index0 % 3 == 0 %}enterprise{% elif loop.index0 % 3 == 1 %}startup{% else %}edu{% endif %}">{{ differentiator.id }}</span>
          <h3>{{ differentiator.title }}</h3>
          <p>{{ differentiator.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% for module in products.modules %}
  <section class="section{% if loop.index is even %} section--subtle{% endif %}" id="{{ module.id }}">
    <div class="container">
      <p class="tagline">Module {{ loop.index }}</p>
      <h2 class="section-heading">{{ module.name }}</h2>
      <p class="section-subheading">{{ module.tagline }}</p>
      <p style="max-width: 760px; margin: 1rem 0 2rem; color: var(--n700);">{{ module.description }}</p>
      <div class="card-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
        {% for capability in module.capabilities %}
          <div class="card reveal">
            <span class="card-badge card-badge--{% if loop.index0 % 3 == 0 %}enterprise{% elif loop.index0 % 3 == 1 %}startup{% else %}edu{% endif %}">Capability</span>
            <h3 style="font-size: 1.1rem;">{{ capability.name }}</h3>
            <p>{{ capability.description }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endfor %}

<section class="section section--subtle">
  <div class="container text-center">
    <h2 class="section-heading" style="margin-bottom: 1rem;">Need something custom?</h2>
    <p class="page-subtitle" style="margin: 0 auto 2rem;">Products are a starting point. If your challenge requires hands-on partnership, explore our consulting services or book a call.</p>
    <div class="btn-group" style="justify-content: center;">
      <a href="/services/" class="btn-secondary">View services</a>
      <a href="/about/#contact" class="btn-primary">Book a call &rarr;</a>
    </div>
  </div>
</section>

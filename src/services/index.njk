---
layout: layouts/base.njk
title: Services
description: AI strategy, product strategy, and higher education consulting — hands-on engagements that turn insight into implementation.
---

<section class="page-header">
  <div class="container">
    <p class="tagline">Services</p>
    <h1 class="page-title">{{ services.headline }}</h1>
    <p class="page-subtitle">{{ services.subheadline }}</p>
  </div>
</section>

<section class="section" id="onboarding">
  <div class="container">
    <p class="tagline">Onboarding</p>
    <h2 class="section-heading">{{ services.onboarding.title }}</h2>
    <p style="max-width: 760px; margin: 1rem 0 2rem; color: var(--n700);">{{ services.onboarding.description }}</p>
    <div class="card-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
      {% for step in services.onboarding.steps %}
        <div class="card reveal">
          <span class="card-badge card-badge--{% if loop.index0 % 3 == 0 %}enterprise{% elif loop.index0 % 3 == 1 %}startup{% else %}edu{% endif %}">Step {{ step.step }}</span>
          <h3>{{ step.title }}</h3>
          <p>{{ step.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--subtle" id="approach">
  <div class="container">
    <p class="tagline">Approach</p>
    <h2 class="section-heading" style="margin-bottom: 2rem;">{{ services.approach.title }}</h2>
    <div class="card-grid">
      {% for point in services.approach.points %}
        <div class="card reveal">
          <span class="card-badge card-badge--{% if loop.index0 % 3 == 0 %}enterprise{% elif loop.index0 % 3 == 1 %}startup{% else %}edu{% endif %}">{{ loop.index }}</span>
          <h3>{{ point.title }}</h3>
          <p>{{ point.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--dark">
  <div class="container text-center">
    <h2 class="section-heading" style="margin-bottom: 1rem;">{{ services.cta.heading }}</h2>
    <p style="max-width: 580px; margin: 0 auto 2rem; color: #8899CC; line-height: 1.6;">{{ services.cta.description }}</p>
    <a href="{{ services.cta.button_link }}" class="btn-primary">{{ services.cta.button_text }} &rarr;</a>
  </div>
</section>

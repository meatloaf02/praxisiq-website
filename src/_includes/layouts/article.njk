---
layout: layouts/base.njk
---

<section class="page-header">
  <div class="container">
    {% if badge %}
      <span class="card-badge card-badge--{{ badgeType or 'enterprise' }}" style="margin-bottom: 0.75rem;">{{ badge }}</span>
    {% endif %}
    <h1 class="page-title">{{ title }}</h1>
    {% if date %}
      <p class="text-muted" style="margin-top: 0.5rem; font-size: 0.875rem;">{{ date | dateFormat }}</p>
    {% endif %}
    {% if venue %}
      <p class="section-subheading" style="margin-top: 0.75rem;">{{ venue }}</p>
    {% endif %}
    {% if abstract %}
      <p class="page-subtitle" style="margin-top: 1rem;">{{ abstract }}</p>
    {% endif %}
  </div>
</section>

<section class="section">
  <div class="container" style="max-width: 720px;">
    <article>
      {{ content | safe }}
    </article>
    <hr style="border: none; border-top: 1px solid var(--n100); margin: 3rem 0;">
    <p><a href="/research/">&larr; Back to Research</a></p>
  </div>
</section>

{% if researchItem %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ScholarlyArticle",
    "headline": {{ title | json | safe }},
    "author": {
      "@type": "Person",
      "name": {{ (authors or "Marco Siliezar") | json | safe }}
    },
    "datePublished": "{{ date | htmlDateString }}",
    "description": {{ (description or abstract or summary or site.description) | json | safe }},
    "keywords": {{ (keywords or "") | json | safe }},
    "url": "{{ site.url }}{{ page.url }}",
    "publisher": {
      "@type": "Organization",
      "name": {{ site.name | json | safe }}
    }
  }
  </script>
{% endif %}
